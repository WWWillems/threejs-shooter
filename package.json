{
  "name": "threejs-shooter",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:app": "npm run dev -w app",
    "dev:editor": "npm run dev:editor -w app",
    "dev:server": "npm run dev -w server",
    "import:level": "node --import tsx scripts/levels/import-level.mjs",
    "generate:default-level": "node --import tsx scripts/levels/generate-default-level.mjs",
    "build:app": "npm run build -w app",
    "build:server": "npm run build -w server",
    "build": "npm run build:app && npm run build:server",
    "typecheck": "tsc -p shared && tsc -p server --noEmit && tsc -p app",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  }
}
